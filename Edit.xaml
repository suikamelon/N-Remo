                                <DataTemplate>
                                    <StackPanel Margin="0">
                                        <TextBox Text="{Binding OtherValue3Display, Mode=OneWay}" Style="{StaticResource SelectableSensorTextStyle}"/>
                                        <ComboBox ItemsSource="{Binding AvailableButtonNumbers}" SelectedItem="{Binding OtherButtonNumber3, Mode=TwoWay}"
