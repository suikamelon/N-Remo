                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="4" Padding="14" CornerRadius="8"
                        Background="{StaticResource ControlBackgroundBrush}"
                        BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="CheckBoxSensorAutoUpdate" Content="自動更新する"
                                      VerticalAlignment="Center"
                                      Checked="ServerSensorSetting_Changed"
                                      Unchecked="ServerSensorSetting_Changed"/>
                            <TextBlock Text="更新間隔" Margin="24,0,8,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TextBoxSensorUpdateInterval" Width="70" Height="25"
                                     VerticalContentAlignment="Center" LostFocus="ServerSensorSetting_Changed"/>
                            <TextBlock Text="秒（30～3600）" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Margin="24,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{DynamicResource 推奨更新間隔：300秒（5分）以上}"/>
                        <TextBlock Margin="24,3,0,0"
                                   Foreground="#C42B1C" TextWrapping="Wrap"
                                   Text="{DynamicResource ※更新間隔が短いとAPIの利用上限に達し、取得や操作ができなくなる場合があります。接続台数が多いほど、1回の更新で必要なAPI呼び出し回数も増えます。}"/>
                        <TextBlock Margin="24,3,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource ※Webhook有効時、このオプションがオフならSwitchBotは通常の自動更新でAPI取得を行いません。今すぐ更新とコマンド実行後の更新では常に全状態を取得します。}"/>
                        <CheckBox x:Name="CheckBoxSensorAutoUpdateSwitchBotWithWebhook"
                                  Margin="24,7,0,0"
                                  Content="{DynamicResource Webhook有効時でもSwitchBotを自動更新する}"
                                  VerticalAlignment="Center"
                                  Checked="ServerSensorSetting_Changed"
                                  Unchecked="ServerSensorSetting_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox x:Name="CheckBoxSensorRefreshAfterCommand"
                                      Content="コマンドが実行されたら"
                                      VerticalAlignment="Center"
                                      Checked="ServerSensorSetting_Changed"
                                      Unchecked="ServerSensorSetting_Changed"/>
                            <TextBox x:Name="TextBoxSensorRefreshAfterCommandSeconds"
                                     Width="70" Height="25" Margin="8,0,0,0"
                                     VerticalContentAlignment="Center"
                                     LostFocus="ServerSensorSetting_Changed"/>
                            <TextBlock Text="秒後に更新する（1～3600）"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox x:Name="CheckBoxSensorLogRetention"
                                      Content="指定日数のログを保存する"
                                      VerticalAlignment="Center"
                                      Checked="ServerSensorSetting_Changed"
                                      Unchecked="ServerSensorSetting_Changed"/>
                            <TextBox x:Name="TextBoxSensorLogRetentionDays"
                                     Width="70" Height="25" Margin="8,0,0,0"
                                     VerticalContentAlignment="Center"
                                     LostFocus="ServerSensorSetting_Changed"/>
                            <TextBlock Text="日（1～3650）" Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ログの保存先" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TextBoxSensorLogDirectory" Grid.Column="1" Height="25"
                                     VerticalContentAlignment="Center"
                                     ToolTip="空欄の場合はN-Remo.exeと同じ場所のSensorLogsフォルダー"
                                     LostFocus="ServerSensorSetting_Changed"/>
                            <Button Grid.Column="2" Content="選択" Height="25" Margin="8,0,0,0"
                                    Click="SelectSensorLogDirectory_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <TabItem x:Name="SimpleAutomationTab" Header="簡易オートメーション">
            <Grid>
                <Grid Margin="18">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChecked, ElementName=CheckBoxSensorAutoUpdate}" Value="False"/>
                                        <Condition Binding="{Binding IsChecked, ElementName=CheckBoxWebhookRelayEnabled}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="2*" MinHeight="120"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="3*" MinHeight="150"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="簡易オートメーションは、サーバーセンサーの自動更新またはWebhookリアルタイム接続で受信した値を使って動作します。" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="オートメーション追加" Height="25" Margin="0,0,8,0" Click="AddSimpleAutomation_Click"/>
                            <Button Content="{DynamicResource 上へ移動}" Height="25" Margin="0,0,8,0" Click="MoveAutomationUp_Click"/>
                            <Button Content="{DynamicResource 下へ移動}" Height="25" Margin="0,0,8,0" Click="MoveAutomationDown_Click"/>
                            <Button Content="選択オートメーションを削除" Height="25" Click="DeleteSimpleAutomation_Click"/>
                    </StackPanel>
                    <ListBox x:Name="AutomationRuleList" Grid.Row="4" Grid.RowSpan="7"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#C6DFFF"/>
                                        <Setter Property="BorderBrush" Value="#5B9BD5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                    BorderThickness="1" CornerRadius="8" Padding="10">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          Expanded="AutomationRuleExpander_Expanded">
                                        <Expander.Header>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Content="{DynamicResource 有効}" IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="AutomationRuleCheckBox_Click"/>
                                                <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Height="25" Margin="4,0,10,0" VerticalContentAlignment="Center"
                                                     LostFocus="AutomationRuleTextBox_LostFocus"/>
                                                <CheckBox Grid.Column="3" Content="{DynamicResource デスクトップ通知}"
                                                      IsChecked="{Binding IsNotificationEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" Margin="12,0,4,0"
                                                      Click="AutomationRuleCheckBox_Click"/>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Margin="28,10,4,2">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <Button Content="{DynamicResource 条件追加}" Height="25" Margin="0,0,0,8" Click="AddAutomationCondition_Click"/>
                                                    <Button Content="{DynamicResource 選択条件の削除}" Height="25" Click="DeleteAutomationCondition_Click"/>
                                                </StackPanel>
                                                <DataGrid Grid.Column="1" ItemsSource="{Binding Conditions}"
                                                  SelectedItem="{Binding SelectedCondition, Mode=TwoWay}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  SelectionMode="Single" RowHeight="34" ColumnHeaderHeight="20" MaxHeight="250"
                                                  RowEditEnding="AutomationCondition_RowEditEnding"
                                                  CurrentCellChanged="AutomationCondition_CurrentCellChanged">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                        <Setter Property="FontSize" Value="10"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGrid.CellStyle>
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="{DynamicResource 有効}" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="48">
                                                        <DataGridCheckBoxColumn.ElementStyle>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridCheckBoxColumn.ElementStyle>
                                                    </DataGridCheckBoxColumn>
                                                    <DataGridTemplateColumn Header="{DynamicResource 起動条件・トリガーとなるデバイス}" Width="300">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding TriggerOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding TriggerSensorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="AutomationTrigger_SelectionChanged" Height="22" Margin="2"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="{DynamicResource データ}" Width="120">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding DataOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding TriggerDataLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Data" SelectionChanged="AutomationConditionValue_Changed" Height="22" Margin="2"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="{DynamicResource データ値}" Width="100">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <TextBox Text="{Binding ConditionValueDisplay, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                                             LostFocus="AutomationConditionValueTextBox_LostFocus"
                                                                             VerticalContentAlignment="Center" TextAlignment="Center" Margin="2">
                                                                        <TextBox.Style>
                                                                            <Style TargetType="TextBox">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsPresenceMode}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBox.Style>
                                                                    </TextBox>
                                                                    <ComboBox ItemsSource="{Binding ConditionValueOptions}"
                                                                              DisplayMemberPath="Display" SelectedValuePath="Value"
                                                                              SelectedValue="{Binding ConditionValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              Tag="ConditionValue" SelectionChanged="AutomationConditionValue_Changed"
                                                                              Height="22" Margin="2">
                                                                        <ComboBox.Style>
                                                                            <Style TargetType="ComboBox">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsPresenceMode}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ComboBox.Style>
                                                                    </ComboBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="{DynamicResource 条件}" Width="90">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding ComparisonOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Comparison, Mode=TwoWay}" Tag="Comparison" SelectionChanged="AutomationConditionValue_Changed" Height="22" Margin="2"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                            <WrapPanel Margin="0,2,0,8" VerticalAlignment="Center">
                                                <WrapPanel.Style>
                                                    <Style TargetType="WrapPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTimeCondition}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </WrapPanel.Style>
                                                <TextBlock Text="{DynamicResource 実行頻度}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ComboBox Width="145" Height="22"
                                                          ItemsSource="{Binding ExecutionFrequencyOptions}"
                                                          DisplayMemberPath="Display" SelectedValuePath="Value"
                                                          SelectedValue="{Binding ExecutionFrequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectionChanged="AutomationFrequency_SelectionChanged"/>
                                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelectedDaysFrequency}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <CheckBox Content="{DynamicResource 月}" IsChecked="{Binding MondaySelected}" Click="AutomationRuleCheckBox_Click" Margin="0,0,7,0"/>
                                                    <CheckBox Content="{DynamicResource 火}" IsChecked="{Binding TuesdaySelected}" Click="AutomationRuleCheckBox_Click" Margin="0,0,7,0"/>
                                                    <CheckBox Content="{DynamicResource 水}" IsChecked="{Binding WednesdaySelected}" Click="AutomationRuleCheckBox_Click" Margin="0,0,7,0"/>
                                                    <CheckBox Content="{DynamicResource 木}" IsChecked="{Binding ThursdaySelected}" Click="AutomationRuleCheckBox_Click" Margin="0,0,7,0"/>
                                                    <CheckBox Content="{DynamicResource 金}" IsChecked="{Binding FridaySelected}" Click="AutomationRuleCheckBox_Click" Margin="0,0,7,0"/>
                                                    <CheckBox Content="{DynamicResource 土}" IsChecked="{Binding SaturdaySelected}" Click="AutomationRuleCheckBox_Click" Margin="0,0,7,0"/>
                                                    <CheckBox Content="{DynamicResource 日}" IsChecked="{Binding SundaySelected}" Click="AutomationRuleCheckBox_Click"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWeeklyFrequency}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ComboBox Width="100" Height="22"
                                                              ItemsSource="{Binding WeekdayOptions}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Value"
                                                              SelectedValue="{Binding WeeklyDayValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectionChanged="AutomationFrequency_SelectionChanged"/>
                                                </StackPanel>
                                                <Button Content="{DynamicResource 1回実行を未実行に戻す}" Height="25" Margin="12,0,0,0"
                                                        Click="ResetOnceAutomation_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnceFrequency}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <TextBlock Text="{DynamicResource 実行済み}" Foreground="#666666" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsOnceFrequency}" Value="True"/>
                                                                        <Condition Binding="{Binding HasExecutedOnce}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{DynamicResource 未実行}" Foreground="#666666" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsOnceFrequency}" Value="True"/>
                                                                        <Condition Binding="{Binding HasExecutedOnce}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </WrapPanel>
                                            <Grid Margin="0,10,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource 条件を（組み合わせ）}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding LogicalOperatorOptions}"
                                                      DisplayMemberPath="Display" SelectedValuePath="Value"
                                                      SelectedValue="{Binding LogicalOperator, Mode=TwoWay}"
                                                      SelectionChanged="AutomationValue_Changed" Height="22"/>
                                                <TextBlock Grid.Column="2" Text="{DynamicResource 条件を}" VerticalAlignment="Center" Margin="18,0,6,0"/>
                                                <TextBox Grid.Column="3" Text="{Binding RequiredConsecutiveCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Width="50" Height="25" TextAlignment="Center" VerticalContentAlignment="Center"
                                                     LostFocus="AutomationRuleTextBox_LostFocus"/>
                                                <TextBlock Grid.Column="4" Text="{DynamicResource 分継続後に実行（0で即時実行）}" VerticalAlignment="Center" Margin="6,0,18,0"/>
                                                <TextBox Grid.Column="5" Text="{Binding DelayMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Width="50" Height="25" TextAlignment="Center" VerticalContentAlignment="Center"
                                                     LostFocus="AutomationRuleTextBox_LostFocus"/>
                                                <TextBlock Grid.Column="6" Text="{DynamicResource 分後に遅延実行}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <CheckBox Grid.Column="7"
                                                          Content="{DynamicResource 一時運転保護中は実行しない}"
                                                          IsChecked="{Binding SkipWhileTemporaryProtection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="AutomationRuleCheckBox_Click"
                                                          VerticalAlignment="Center" Margin="18,0,0,0"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <Button Content="{DynamicResource コマンド追加}" Height="25" Margin="0,0,0,8" Click="AddAutomationAction_Click"/>
                                                    <Button Content="{DynamicResource 選択コマンドの削除}" Height="25" Click="DeleteAutomationAction_Click"/>
                                                </StackPanel>
                                                <DataGrid Grid.Column="1" ItemsSource="{Binding Actions}"
                                                      SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                                      SelectionMode="Single" RowHeight="34" ColumnHeaderHeight="20" MaxHeight="220">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                        <Setter Property="FontSize" Value="10"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>
                                                <DataGrid.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGrid.CellStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="No" Binding="{Binding DisplayOrder}" Width="48" IsReadOnly="True">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="TextAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTemplateColumn Header="{DynamicResource 実行するコマンド：}" Width="300">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ComboBox ItemsSource="{Binding CommandOptions}"
                                                                          DisplayMemberPath="Display" SelectedValuePath="Value"
                                                                          SelectedValue="{Binding CommandId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          SelectionChanged="AutomationActionValue_Changed" Height="22" Margin="2"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="{DynamicResource 保護時間（分）}" Width="120">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding ProtectionMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                         Width="70" Height="22" TextAlignment="Center"
                                                                         VerticalContentAlignment="Center"
                                                                         LostFocus="AutomationActionTextBox_LostFocus">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding CommandId}" Value="Protection:Start">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DataGrid x:Name="DataGridSimpleAutomations" Grid.Row="4"
                          Visibility="Collapsed"
                          AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" RowHeight="34"
                          SelectionChanged="SimpleAutomation_SelectionChanged"
                          RowEditEnding="SimpleAutomation_RowEditEnding" CurrentCellChanged="SimpleAutomation_CurrentCellChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="有効" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="48">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="名前" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="条件の組み合わせ" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding LogicalOperatorOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding LogicalOperator, Mode=TwoWay}"
                                          SelectionChanged="AutomationValue_Changed" Height="22" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="何分後に実行" Binding="{Binding DelayMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="実行するコマンド" Width="*" MinWidth="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding CommandOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding ActionCommandId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionChanged="AutomationValue_Changed" Height="22" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="デスクトップ通知"
                                                Binding="{Binding IsNotificationEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="56">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="6" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="選択ルールの条件" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="条件追加" Height="25" Margin="0,0,8,0" Click="AddAutomationCondition_Click"/>
                        <Button Content="選択条件の削除" Height="25" Click="DeleteAutomationCondition_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="DataGridAutomationConditions" Grid.Row="8" AutoGenerateColumns="False"
                          Visibility="Collapsed"
                          CanUserAddRows="False" SelectionMode="Single" RowHeight="34"
                          RowEditEnding="AutomationCondition_RowEditEnding" CurrentCellChanged="AutomationCondition_CurrentCellChanged">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="有効" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="48">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTemplateColumn Header="起動条件・トリガーとなるデバイス" Width="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding TriggerOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding TriggerSensorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="AutomationTrigger_SelectionChanged" Height="22" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="データ" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding TriggerDataLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Data" SelectionChanged="AutomationConditionValue_Changed" Height="22" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="データ値" Binding="{Binding ConditionValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="条件" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding ComparisonOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Comparison, Mode=TwoWay}" Tag="Comparison" SelectionChanged="AutomationConditionValue_Changed" Height="22" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="10" Visibility="Collapsed" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Text="※すべて満たす：温度22以下 かつ 人感あり、など。いずれかを満たす：条件のどれか1つで実行。成立状態の間は1回だけ実行し、いったん不成立になった後に再実行できます。"/>
                </Grid>
                <Border Background="#CCFFFFFF" CornerRadius="8" Margin="18" Panel.ZIndex="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsChecked, ElementName=CheckBoxSensorAutoUpdate}" Value="False"/>
                                        <Condition Binding="{Binding IsChecked, ElementName=CheckBoxWebhookRelayEnabled}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="簡易オートメーションを使用するには、サーバーセンサーの自動更新またはWebhookリアルタイム接続を有効にしてください。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16" Margin="24"/>
                </Border>
            </Grid>
        </TabItem>

        <TabItem x:Name="WebhookRelayTab" Header="Webhook連携">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22" MaxWidth="880">
                    <TextBlock Text="Webhook連携" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,6,0,14" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="SwitchBotの状態変更を、ユーザー自身が用意した無料の中継サービスで受信します。SwitchBotのTokenとSecretも中継サービスには保存しません。"/>

                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10"
                            Background="#EEF6FF" BorderBrush="#B7D7F5">
                        <StackPanel>
                            <TextBlock Text="Webhookを使うメリット"
                                       FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="・SwitchBotの状態変更をリアルタイム接続で受け取れます。&#x0a;・定期的なイベント確認を行わないため、不要な通信やAPI問い合わせを減らせます。&#x0a;・人感センサーやドア、ロックなどの変化を簡易オートメーションへすぐに反映できます。&#x0a;※通信が切れた場合はN-Remoが自動的に再接続します。"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="CheckBoxWebhookRelayEnabled" Grid.ColumnSpan="2"
                                      Content="Webhook連携を有効にする" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Text="利用する中継サービス" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ComboBoxWebhookRelayProvider" Grid.Row="1" Grid.Column="1" Height="22" Width="230" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Cloudflare WebSocket" Tag="CloudflareRealtime"/>
                                <ComboBoxItem Content="Firebase Realtime Database" Tag="Firebase"/>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="リアルタイム接続URL" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBox x:Name="TextBoxWebhookRelayBaseUrl" Grid.Row="2" Grid.Column="1" Height="25" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="3" Text="Webhook受信URL" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBox x:Name="TextBoxWebhookReceiveUrl" Grid.Row="3" Grid.Column="1" Height="25" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="4" Text="接続キー / Web APIキー" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <PasswordBox x:Name="PasswordBoxWebhookApiKey" Grid.Row="4" Grid.Column="1" Height="25" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="5" Text="Firebase専用メール" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBox x:Name="TextBoxWebhookFirebaseEmail" Grid.Row="5" Grid.Column="1" Height="25" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="6" Text="Firebase専用パスワード" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <PasswordBox x:Name="PasswordBoxWebhookFirebasePassword" Grid.Row="6" Grid.Column="1" Height="25" Margin="0,8,0,0"/>
                            <WrapPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                <Button Content="設定を保存" Width="100" Height="28" Click="SaveWebhookSettings_Click"/>
                                <Button Content="接続確認" Width="90" Height="28" Margin="10,0,0,0" Click="CheckWebhookRelay_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="SwitchBot Webhook登録" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="SwitchBot設定タブのTokenとSecretを使い、N-RemoからSwitchBotへ直接登録します。既存のWebhookがある場合は、状態確認の結果を確認してから登録してください。" TextWrapping="Wrap" Margin="0,5,0,10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <WrapPanel>
                                <Button Content="Webhookを登録" Width="115" Height="28" Click="RegisterSwitchBotWebhook_Click"/>
                                <Button Content="登録状態を確認" Width="125" Height="28" Margin="10,0,0,0" Click="QuerySwitchBotWebhook_Click"/>
                                <Button Content="Webhookを解除" Width="115" Height="28" Margin="10,0,0,0" Click="DeleteSwitchBotWebhook_Click"/>
                            </WrapPanel>
                            <TextBox x:Name="TextBoxWebhookStatus" Margin="0,10,0,0" MinHeight="64"
                                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>

                    <Expander Header="Cloudflare WebSocket方式の詳しい手順" IsExpanded="True" Margin="0,0,0,8">
                        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Cloudflare Durable ObjectsがWebhookを受信し、N-RemoのWebSocketへ即時配信します。切断中のイベントも保存され、再接続時に未受信分が配信されます。"/>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="手順 1：Cloudflareの無料アカウントを作成します。&#x0a;手順 2：下のボタンでテンプレートフォルダーを開き、CloudflareフォルダーのREADME.txtを確認します。&#x0a;手順 3：Node.jsを導入し、npm install、wrangler loginを実行します。&#x0a;手順 4：API_KEYとWEBHOOK_SECRETをWranglerのSecretとして登録します。&#x0a;手順 5：npm run deployを実行します。&#x0a;手順 6：発行URLをリアルタイム接続URLへ、発行URL/webhook/WEBHOOK_SECRETをWebhook受信URLへ入力します。&#x0a;手順 7：API_KEYを接続キーへ入力し、接続確認、設定保存、Webhook登録の順に実行します。"/>
                                <Button Content="Cloudflareテンプレートを開く" Width="210" Height="28" HorizontalAlignment="Left" Margin="0,12,0,0" Tag="Cloudflare" Click="OpenWebhookTemplate_Click"/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="Firebase Realtime Database方式の詳しい手順" Margin="0,0,0,8">
                        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Google Apps ScriptがWebhookをFirebaseへ保存し、N-RemoはSSEでデータ変更をリアルタイム購読します。Firebase Authenticationのメールアドレス／パスワード認証を使用します。"/>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="手順 1：FirebaseでプロジェクトとRealtime Databaseを作成します。&#x0a;手順 2：Authenticationでメールアドレス／パスワード認証を有効にし、専用ユーザーを作成します。&#x0a;手順 3：専用ユーザーのUIDをテンプレートのdatabase.rules.jsonへ設定して適用します。&#x0a;手順 4：Apps ScriptへFirebaseフォルダーのCode.gsとappsscript.jsonを設定し、ウェブアプリとして公開します。&#x0a;手順 5：Database URL、Web APIキー、専用ユーザー情報、GASのWebhook URLをN-Remoへ入力し、接続確認、設定保存、Webhook登録の順に実行します。&#x0a;※詳しい操作は「Firebaseテンプレートを開く」からREADME.txtを確認してください。"/>
                                <Button Content="Firebaseテンプレートを開く" Width="195" Height="28" HorizontalAlignment="Left" Margin="0,12,0,0" Tag="Firebase" Click="OpenWebhookTemplate_Click"/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <TextBlock TextWrapping="Wrap" Foreground="#A03030"
                               Text="注意：Webhookで通知されない機種・状態があります。中継サービスが停止した場合に備え、重要な制御をWebhookだけに依存させないでください。URLとAPIキーを第三者へ公開しないでください。"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem x:Name="SensorLogTab" Header="センサーログ">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="2*" MinHeight="210"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*" MinHeight="180"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="センサー" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ComboBoxSensorLogDevice" Grid.Column="1" Height="22"
                              DisplayMemberPath="DeviceName" SelectedValuePath="SensorId"
                              SelectionChanged="SensorLogFilter_Changed"/>
                    <TextBlock Grid.Column="2" Text="項目" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <ComboBox x:Name="ComboBoxSensorLogMetric" Grid.Column="3" Height="22"
                              DisplayMemberPath="MetricDisplay" SelectedValuePath="Metric"
                              SelectionChanged="SensorLogFilter_Changed"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="TextBlockSensorLogRange" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="5" Content="全期間" Height="28" Margin="0,0,8,0"
                            Click="ResetSensorLogRange_Click"/>
                    <Button Grid.Column="6" Content="ログを更新" Height="28"
                            Click="RefreshSensorLogs_Click"/>
                </Grid>
                <Border Grid.Row="2" Background="{StaticResource ControlBackgroundBrush}"
                        BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10">
                    <Grid>
                        <Canvas x:Name="SensorLogChart" Background="Transparent"
                                SizeChanged="SensorLogChart_SizeChanged"
                                MouseLeftButtonDown="SensorLogChart_MouseLeftButtonDown"
                                MouseMove="SensorLogChart_MouseMove"
                                MouseLeftButtonUp="SensorLogChart_MouseLeftButtonUp"
                                MouseLeave="SensorLogChart_MouseLeave"/>
                        <TextBlock x:Name="TextBlockSensorLogEmpty"
                                   Text="グラフ表示できる数値ログがありません。"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <DataGrid x:Name="DataGridSensorLogs" Grid.Row="4"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" IsReadOnly="True" RowHeight="28"
                          VerticalAlignment="Stretch"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource {x:Type ScrollBar}}">
                            <Setter Property="Width" Value="8"/>
                            <Setter Property="Height" Value="8"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="Transparent">
                                            <Track x:Name="PART_Track"
                                                   Orientation="Vertical"
                                                   IsDirectionReversed="True"
                                                   Margin="0,1"
                                                   Minimum="{TemplateBinding Minimum}"
                                                   Maximum="{TemplateBinding Maximum}"
                                                   ViewportSize="NaN"
                                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                   SnapsToDevicePixels="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource VerticalScrollThumbStyle}">
                                                        <Thumb.Height>
                                                            <MultiBinding Converter="{StaticResource ScrollThumbSizeConverter}">
                                                                <Binding Path="ActualHeight"
                                                                         RelativeSource="{RelativeSource AncestorType={x:Type Track}}"/>
                                                                <Binding Path="ViewportSize"
                                                                         RelativeSource="{RelativeSource AncestorType={x:Type ScrollBar}}"/>
                                                                <Binding Path="Minimum"
                                                                         RelativeSource="{RelativeSource AncestorType={x:Type ScrollBar}}"/>
                                                                <Binding Path="Maximum"
                                                                         RelativeSource="{RelativeSource AncestorType={x:Type ScrollBar}}"/>
                                                            </MultiBinding>
                                                        </Thumb.Height>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Height" Value="Auto"/>
                                </Trigger>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日時" Binding="{Binding TimestampDisplay}" Width="155"/>
                        <DataGridTextColumn Header="提供元" Binding="{Binding Provider}" Width="110"/>
                        <DataGridTextColumn Header="デバイス名" Binding="{Binding DeviceName}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="項目" Binding="{Binding MetricDisplay}" Width="120"/>
                        <DataGridTextColumn Header="値" Binding="{Binding ValueDisplay}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="5"
                           Text="※一覧には選択期間内の最新1,000件まで表示します。グラフは選択期間全体を参照します。"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="AboutTab" Header="About">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="34,28" MaxWidth="900" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/N-AppIcon.png" Width="64" Height="64"
                               Margin="0,0,18,0"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="N-Remo" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TextBlockAboutVersion" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="1,5,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,24,0,0" Padding="20"
                            CornerRadius="12" BorderThickness="1"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            Background="{StaticResource CardBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="N-Remoについて" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="N-RemoはNature Remo、SwitchBot、TuyaをWindowsから操作するための非公式アプリケーションです。"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Nature Remo、SwitchBot、Tuyaおよび各製品名・商標は、それぞれの権利者に帰属します。"/>
                            <TextBlock Margin="0,12,0,0" Text="Copyright © 2026 suikamelon"/>
                            <TextBlock Text="MIT License"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,16,0,0" Padding="20"
                            CornerRadius="12" BorderThickness="1"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            Background="{StaticResource CardBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="リンク" FontSize="18" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="GitHubを開く" Width="145" Height="34"
                                        Margin="0,0,10,10" Click="OpenGitHub_Click"/>
                                <Button Content="リリースを開く" Width="145" Height="34"
                                        Margin="0,0,10,10" Click="OpenGitHubReleases_Click"/>
                                <Button Content="不具合・要望を送る" Width="165" Height="34"
                                        Margin="0,0,10,10" Click="OpenGitHubIssues_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Margin="0,16,0,24" Padding="20"
                            CornerRadius="12" BorderThickness="1"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            Background="{StaticResource CardBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="アップデート" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="GitHub Releasesへ接続して、公開されている最新安定版を確認します。更新のダウンロードやインストールは自動では行いません。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="ButtonCheckForUpdates" Content="最新バージョンを確認"
                                        Width="190" Height="34" Click="CheckForUpdates_Click"/>
                                <Button x:Name="ButtonOpenLatestRelease" Content="最新リリースを開く"
                                        Width="175" Height="34" Margin="10,0,0,0"
                                        IsEnabled="False" Click="OpenLatestRelease_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TextBlockUpdateStatus" Margin="0,12,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
