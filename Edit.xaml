<Window x:Class="N_Remo.Edit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:N_Remo"
        mc:Ignorable="d"
        Title="N-Remo 設定・ボタン編集" Height="820" Width="960"
        MinHeight="760" MinWidth="820"
        Icon="/Resources/NR-AppIcon.ico"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- マウスオーバーでは背景色を変えず、影だけを表示するEdit専用ボタン -->
        <Style x:Key="EditButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" BlurRadius="10"
                                                          ShadowDepth="2" Opacity="0.30"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditPrimaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource EditButtonStyle}"/>
        <Style TargetType="Button" BasedOn="{StaticResource EditPrimaryButtonStyle}"/>
    </Window.Resources>
    <TabControl x:Name="EditTabControl" Margin="10"
                SelectionChanged="EditTabControl_SelectionChanged">
        <TabItem x:Name="ButtonEditTab" Header="ボタン編集">
            <Grid Background="{StaticResource WindowBackgroundBrush}" Margin="18">
                <Grid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource EditButtonStyle}">
                        <Setter Property="Background" Value="#4A90D9"/>
                        <Setter Property="BorderBrush" Value="#4A90D9"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="168"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TextBoxNo" HorizontalAlignment="Left" Height="20" TextWrapping="Wrap" Text="Button001" VerticalAlignment="Top" Width="15" IsTabStop="False"  x:FieldModifier="public"/>

                <DataGrid x:Name="DataGridButtons"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          ScrollViewer.CanContentScroll="False"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          RowHeight="28"
          ColumnHeaderHeight="32"
          SelectionChanged="DataGridButtons_SelectionChanged"
          CellEditEnding="DataGridButtons_CellEditEnding"
          Margin="0,0,18,0" Grid.Column="0">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <!-- アプリ側の細いテンプレートをDataGrid内でも使用する -->
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource {x:Type ScrollBar}}">
                            <Setter Property="Width" Value="8"/>
                            <Setter Property="Height" Value="8"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Height" Value="Auto"/>
                                </Trigger>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <SolidColorBrush
                x:Key="{x:Static SystemColors.HighlightBrushKey}"
                Color="#4A90E2" />
                        <SolidColorBrush
                x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                Color="White" />

                        <SolidColorBrush
                x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                Color="#4A90E2" />
                        <SolidColorBrush
                x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                Color="White" />
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <!-- 表示/非表示 -->
                        <DataGridCheckBoxColumn Header="表示"
                Binding="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Width="35">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <EventSetter Event="Click"
                                                 Handler="ButtonVisibilityGridCheckBox_Click"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                            <DataGridCheckBoxColumn.EditingElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <EventSetter Event="Click"
                                                 Handler="ButtonVisibilityGridCheckBox_Click"/>
                                </Style>
                            </DataGridCheckBoxColumn.EditingElementStyle>
                        </DataGridCheckBoxColumn>

                        <!-- Button名 -->
                        <DataGridTextColumn Header="No"
                            Binding="{Binding Name}"
                            IsReadOnly="True"
                            Width="50"/>

                        <!-- 操作方式 -->
                        <DataGridTextColumn Header="操作"
                            Binding="{Binding ProviderDisplay}"
                            IsReadOnly="True"
                            Width="90"/>

                        <!-- 表示文字 -->
                        <DataGridTextColumn Header="表示名"
                            Binding="{Binding NameContent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            Width="100"/>

                        <!-- 幅 -->
                        <DataGridTextColumn Header="Top"
                            Binding="{Binding Top, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            Width="40"/>

                        <!-- 幅 -->
                        <DataGridTextColumn Header="Left"
                            Binding="{Binding Left, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            Width="40"/>

                        <!-- 幅 -->
                        <DataGridTextColumn Header="幅"
                            Binding="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            Width="40"/>

                        <!-- 高さ -->
                        <DataGridTextColumn Header="高さ"
                            Binding="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            Width="40"/>

                        <!-- フォントサイズ -->
                        <DataGridTextColumn Header="サイズ"
                            Binding="{Binding FontSize}"
                            Width="40"/>

                        <!-- フォントカラー -->
                        <DataGridTextColumn Header="文字色"
                            Binding="{Binding FontColor}"
                            Width="70"/>

                        <!-- 背景色 -->
                        <DataGridTextColumn Header="背景色"
                            Binding="{Binding BackgroundColor}"
                            Width="70"/>

                        <!-- FontWeight -->
                        <DataGridTextColumn Header="太さ"
                            Binding="{Binding FontWeight}"
                            Width="40"/>

                        <!-- Nature Remo赤外線データ -->
                        <DataGridTextColumn Header="赤外線"
                            Binding="{Binding Data1}"
                            Width="120"/>

                        <!-- SwitchBotコマンド（常に一番右） -->
                        <DataGridTextColumn Header="コマンド"
                            Binding="{Binding SwitchBotCommand}"
                            IsReadOnly="True"
                            Width="100"/>

                    </DataGrid.Columns>

                </DataGrid>

                <TextBox Height="20" Margin="0,242,47,0" TextWrapping="Wrap" Text="ボタンの表示名" VerticalAlignment="Top" FontSize="10" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Width="124" IsHitTestVisible="False" IsReadOnly="True" Focusable="False" Grid.ColumnSpan="2"/>

                <Button Content="↑" Height="25" Margin="0,75,62,0" VerticalAlignment="Top" Click="MoveUpButton_Click" FontSize="10" HorizontalAlignment="Right" Width="56" ToolTip="Shiftキーを押しながらだと1ピクセル単位で移動" Grid.Column="1"/>
                <Button Content="←" Height="25" Margin="0,103,93,0" VerticalAlignment="Top" Click="MoveLeftButton_Click" FontSize="10" HorizontalAlignment="Right" Width="56" ToolTip="Shiftキーを押しながらだと1ピクセル単位で移動" Grid.Column="1"/>
                <Button Content="→" Height="25" Margin="0,103,31,0" VerticalAlignment="Top" Click="MoveRightButton_Click" FontSize="10" HorizontalAlignment="Right" Width="56" ToolTip="Shiftキーを押しながらだと1ピクセル単位で移動" Grid.Column="1"/>
                <Button Content="↓" Height="25" Margin="0,131,62,0" VerticalAlignment="Top" Click="MoveDownButton_Click" FontSize="10" HorizontalAlignment="Right" Width="56" ToolTip="Shiftキーを押しながらだと1ピクセル単位で移動" Grid.Column="1"/>
                <Button Content="高＋" Height="25" Margin="0,217,62,0" VerticalAlignment="Top" Click="IncreaseHeightButton_Click" FontSize="9" HorizontalAlignment="Right" Width="56" ToolTip="Shiftキーを押しながらだと1ピクセル単位で変更" Grid.Column="1"/>
                <Button Content="幅－" Height="25" Margin="0,189,93,0" VerticalAlignment="Top" Click="DecreaseWidthButton_Click" FontSize="9" HorizontalAlignment="Right" Width="56" ToolTip="Shiftキーを押しながらだと1ピクセル単位で変更" Grid.Column="1"/>
                <Button Content="幅＋" Height="25" Margin="0,189,31,0" VerticalAlignment="Top" Click="IncreaseWidthButton_Click" FontSize="9" HorizontalAlignment="Right" Width="56" ToolTip="Shiftキーを押しながらだと1ピクセル単位で変更" Grid.Column="1"/>
                <Button Content="高－" Height="25" Margin="0,161,62,0" VerticalAlignment="Top" Click="DecreaseHeightButton_Click" FontSize="9" HorizontalAlignment="Right" Width="56" ToolTip="Shiftキーを押しながらだと1ピクセル単位で変更" Grid.Column="1"/>
                <TextBox x:Name="TextBoxButtonName" Height="24" Margin="0,262,16,0" TextWrapping="Wrap" VerticalAlignment="Top" TextChanged="TextBoxButtonName_TextChanged" LostKeyboardFocus="TextBoxButtonName_LostKeyboardFocus" KeyDown="TextBoxButtonName_KeyDown" Grid.ColumnSpan="2" HorizontalAlignment="Right" Width="153"/>
                <Button Content="文字拡大" Height="25" Margin="0,299,94,0" VerticalAlignment="Top" FontSize="10" HorizontalAlignment="Right" Width="76" Click="IncreaseFontSizeButton_Click" Grid.ColumnSpan="2"/>
                <Button Content="文字縮小" Height="25" Margin="0,299,13,0" VerticalAlignment="Top" FontSize="10" HorizontalAlignment="Right" Width="76" Click="DecreaseFontSizeButton_Click" Grid.Column="1"/>
                <Button Content="文字色" Height="25" Margin="0,329,94,0" VerticalAlignment="Top" Click="Button_Click_11" FontSize="10" HorizontalAlignment="Right" Width="76" Grid.ColumnSpan="2"/>
                <Button Content="背景色" Height="25" Margin="0,329,13,0" VerticalAlignment="Top" Click="Button_Click_10" FontSize="10" HorizontalAlignment="Right" Width="76" Grid.Column="1"/>
                <CheckBox x:Name="CheckBoxVisible" Content="ボタン表示・非表示" Height="16" Margin="0,51,28,0" VerticalAlignment="Top" Checked="CheckBoxVisible_Changed" Unchecked="CheckBoxVisible_Changed" HorizontalAlignment="Right" Width="126" Grid.Column="1"/>
                <TextBox Height="68" Margin="0,438,0,0" TextWrapping="Wrap" Text="登録したい赤外線をネイチャーリモに向けて送信してください。ネイチャーリモ本体が青く光ります。その後取得ボタンを押してください。" VerticalAlignment="Top" FontSize="10" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Width="170" IsHitTestVisible="False" IsReadOnly="True" Focusable="False" Grid.Column="1"/>
                <Button x:Name="ButtonIR" Content="取得" Height="25" Margin="0,506,58,0" VerticalAlignment="Top" FontSize="10" HorizontalAlignment="Right" Width="66" Click="GetIrButton_Click" Grid.Column="1"/>
                <TextBox x:Name="TextBoxIR" Height="102" Margin="0,536,18,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="10" BorderBrush="#FFABADB3" HorizontalAlignment="Right" Width="148" Grid.Column="1" LostKeyboardFocus="TextBoxIR_LostKeyboardFocus"/>
                <TextBox Height="20" Margin="0,425,0,0" TextWrapping="NoWrap" Text="ネイチャーリモ赤外線取得" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" FontWeight="Bold" HorizontalAlignment="Center" Width="152" FontSize="11" Focusable="False" IsReadOnly="True" IsHitTestVisible="False" Grid.Column="1"/>
                <Button Content="最前面移動" Height="25" Margin="79,360,0,0" VerticalAlignment="Top" Click="BringToFrontButton_Click" FontSize="10" HorizontalAlignment="Left" Width="76" Grid.Column="1"/>
                <!-- Button x:Name="ToggleStyleButton" Content="装飾オンオフ" Height="20" Margin="0,100,257,0" VerticalAlignment="Top" Click="ToggleStyleButton_Click" FontSize="10" HorizontalAlignment="Right" Width="60" IsTabStop="False"/-->

                <Button Content="ボタン追加"
            Width="76"
            Height="25"
            Style="{StaticResource EditPrimaryButtonStyle}"
            Click="AddButton_Click" Margin="0,15,94,0" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="11" Grid.ColumnSpan="2"/>

                <Button Content="ボタン削除"
            Width="76"
            Height="25"
            Style="{StaticResource EditPrimaryButtonStyle}"
            Click="DeleteButton_Click" Margin="0,15,13,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Grid.Column="1"/>



                <Button x:Name="MouseOverEffectButton" Content="マウスオーバー装飾ONOFF" Height="25" Margin="0,389,25,0" VerticalAlignment="Top" Click="MouseOverEffectButton_Click" FontSize="10" HorizontalAlignment="Right" Width="126" Grid.Column="1"/>
                <Button x:Name="DevicePanelThemeButton" Content="パネル：ライト" Height="25" Margin="0,389,25,0" VerticalAlignment="Top" Click="DevicePanelThemeButton_Click" FontSize="10" HorizontalAlignment="Right" Width="126" Grid.Column="1" Visibility="Collapsed"/>
                <Button Content="デスクトップにショートカット作成" Height="25" Margin="0,646,13,0" VerticalAlignment="Top" Click="CreateShortcutButton_Click" FontSize="10" HorizontalAlignment="Right" Width="157" Grid.ColumnSpan="2" Style="{StaticResource EditPrimaryButtonStyle}"/>
                <Button x:Name="ButtonFontWeightToggle" Content="太字" Height="25" Margin="0,360,94,0" VerticalAlignment="Top" Click="ButtonFontWeightToggle_Click" FontSize="10" Grid.ColumnSpan="2" HorizontalAlignment="Right" Width="76"/>

            </Grid>
        </TabItem>

        <TabItem x:Name="ServerCommandTab" Header="サーバーコマンド">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="サーバーコマンド" FontSize="20"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="8"
                     Text="Nature Remo(コマンドのみ)、SwitchBot、Tuyaからコマンド・シーンを取得します。"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Margin="0,5,0,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="送信テスト" Height="25"
                    Click="TestSwitchBotCommand_Click"/>
                    <Button Grid.Column="3" Content="コマンドを更新" Height="25"
                    Click="RefreshSwitchBotDevices_Click"/>
                    <Button Grid.Column="5" Content="デバイス別一括登録" Height="25"
                    Click="BatchRegisterServerCommands_Click"/>
                    <Button Grid.Column="7" Content="選択デバイスをパネル追加" Height="25"
                    Click="AddSelectedDevicePanel_Click"/>
                </Grid>

                <DataGrid x:Name="DataGridSwitchBotCommands" Grid.Row="2"
                    AutoGenerateColumns="False" CanUserAddRows="False"
                    CanUserDeleteRows="False" IsReadOnly="False"
                    SelectionMode="Single" RowHeight="30"
                    ScrollViewer.CanContentScroll="False"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <!-- アプリ側の細いテンプレートをDataGrid内でも使用する -->
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource {x:Type ScrollBar}}">
                            <Setter Property="Width" Value="8"/>
                            <Setter Property="Height" Value="8"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Height" Value="Auto"/>
                                </Trigger>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="割り当てボタン" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableButtonNumbers}"
                                              SelectedItem="{Binding AssignedButtonNumbers, Mode=TwoWay}"
                                              SelectionChanged="SwitchBotAssignmentComboBox_SelectionChanged"
                                              Height="22"
                                              Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="提供元" Binding="{Binding SourceDisplayLocalized}" IsReadOnly="True" Width="125"/>
                        <DataGridTextColumn Header="デバイス名" Binding="{Binding DeviceName}" IsReadOnly="True" Width="145"/>
                        <DataGridTextColumn Header="種類" Binding="{Binding DeviceType}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="コマンド" Binding="{Binding Command}" IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="パラメーター" Binding="{Binding Parameter, Mode=TwoWay}" Width="115"/>
                        <DataGridTextColumn Header="説明" Binding="{Binding Description}" IsReadOnly="True" MinWidth="150" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="4"
                           Text="正常に動作しない場合はスマホアプリから単独で動作するシーンを作成して、N-Remoで読み込むと動作可能になります。"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

            </Grid>
        </TabItem>

        <TabItem x:Name="ServerSensorTab" Header="サーバーセンサー">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="サーバーセンサー" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Nature Remo、SwitchBot、Tuyaのセンサー値を取得します。"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="14,3,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="今すぐ更新" Height="25"
                            Click="RefreshServerSensors_Click"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                Margin="0,8,0,0"
                                Orientation="Horizontal">
                        <TextBlock Text="ボタンに割り当てた時にボタンの表示名の@がデータに置き換わります。"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Margin="6,0,0,0"
                                   Text="例：温度 @ ℃ → 温度 24℃。"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="DataGridServerSensors" Grid.Row="2"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" IsReadOnly="False"
                          SelectionMode="Single" RowHeight="58"
                          ScrollViewer.CanContentScroll="False"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Visible"
                          EnableColumnVirtualization="False">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource {x:Type ScrollBar}}">
                            <Setter Property="Width" Value="8"/>
                            <Setter Property="Height" Value="8"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Height" Value="Auto"/>
                                </Trigger>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="SelectableSensorTextStyle" TargetType="TextBox">
                            <Setter Property="IsReadOnly" Value="True"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
                            <Setter Property="Padding" Value="2,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="TextWrapping" Value="NoWrap"/>
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="ログ" Binding="{Binding LogEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="40">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <EventSetter Event="Click" Handler="SensorLogCheckBox_Click"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTemplateColumn Header="提供元" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Provider, Mode=OneWay}" Style="{StaticResource SelectableSensorTextStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="デバイス名" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DeviceName, Mode=OneWay}" Style="{StaticResource SelectableSensorTextStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="種類" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
