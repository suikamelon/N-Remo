                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="データ4" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0">
                                        <TextBox Text="{Binding OtherValue4Display, Mode=OneWay}" Style="{StaticResource SelectableSensorTextStyle}"/>
                                        <ComboBox ItemsSource="{Binding AvailableButtonNumbers}" SelectedItem="{Binding OtherButtonNumber4, Mode=TwoWay}"
                                              Tag="Other4" DropDownClosed="SensorValueAssignmentComboBox_DropDownClosed" Height="22"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="データ5" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0">
                                        <TextBox Text="{Binding OtherValue5Display, Mode=OneWay}" Style="{StaticResource SelectableSensorTextStyle}"/>
                                        <ComboBox ItemsSource="{Binding AvailableButtonNumbers}" SelectedItem="{Binding OtherButtonNumber5, Mode=TwoWay}"
                                              Tag="Other5" DropDownClosed="SensorValueAssignmentComboBox_DropDownClosed" Height="22"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="データ6" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0">
                                        <TextBox Text="{Binding OtherValue6Display, Mode=OneWay}" Style="{StaticResource SelectableSensorTextStyle}"/>
                                        <ComboBox ItemsSource="{Binding AvailableButtonNumbers}" SelectedItem="{Binding OtherButtonNumber6, Mode=TwoWay}"
                                          Tag="Other6" DropDownClosed="SensorValueAssignmentComboBox_DropDownClosed" Height="22"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="データ7" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0">
                                        <TextBox Text="{Binding OtherValue7Display, Mode=OneWay}" Style="{StaticResource SelectableSensorTextStyle}"/>
                                        <ComboBox ItemsSource="{Binding AvailableButtonNumbers}" SelectedItem="{Binding OtherButtonNumber7, Mode=TwoWay}"
                                          Tag="Other7" DropDownClosed="SensorValueAssignmentComboBox_DropDownClosed" Height="22"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="データ8" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0">
                                        <TextBox Text="{Binding OtherValue8Display, Mode=OneWay}" Style="{StaticResource SelectableSensorTextStyle}"/>
                                        <ComboBox ItemsSource="{Binding AvailableButtonNumbers}" SelectedItem="{Binding OtherButtonNumber8, Mode=TwoWay}"
                                          Tag="Other8" DropDownClosed="SensorValueAssignmentComboBox_DropDownClosed" Height="22"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="詳細（取得情報すべて）" Width="320">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding AllValuesDisplay, Mode=OneWay}" Style="{StaticResource SelectableSensorTextStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="最終更新" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding UpdatedAtDisplay, Mode=OneWay}" Style="{StaticResource SelectableSensorTextStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="状態" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Status, Mode=OneWay}" Style="{StaticResource SelectableSensorTextStyle}"/>
                                </DataTemplate>
