<Window x:Class="N_Remo.Setting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:N_Remo"
        mc:Ignorable="d"
        Title="N-Remo 設定" Height="620" Width="370"
        MinHeight="590" MinWidth="350"
        Icon="/Resources/NR-AppIcon.ico"
        WindowStartupLocation="CenterOwner">
    <TabControl Margin="10">
        <TabItem Header="全体設定">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Width="480" Margin="12" HorizontalAlignment="Left">
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="#18000000" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="メインウインドウ" FontWeight="SemiBold"
                                       FontSize="14" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ウインドウサイズ" VerticalAlignment="Center"/>
                                <TextBox x:Name="TextBoxWidth" Grid.Column="1" Height="24"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="×" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="TextBoxHeight" Grid.Column="3" Height="24"
                                         VerticalContentAlignment="Center"/>
                                <Button Grid.Column="5" Content="反映" Height="25"
                                        Click="ApplyWindowSizeButton_Click"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="背景色" VerticalAlignment="Center"/>
                                <Button Grid.Column="5" Content="選択" Height="25"
                                        Click="BackgroundColorButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="#18000000" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="起動・閉じる動作" FontWeight="SemiBold"
                                       FontSize="14" Margin="0,0,0,6"/>
                            <CheckBox x:Name="CheckBoxStartWithWindows"
                                      Content="Windows起動時にN-Remoを起動する"
                                      Margin="0,2" IsThreeState="False"
                                      Checked="StartupSetting_Changed"
                                      Unchecked="StartupSetting_Changed"/>
                            <CheckBox x:Name="CheckBoxStartMinimizedToTray"
                                      Content="起動したらタスクトレイに格納する ※タスクトレイ格納が有効時"
                                      Margin="0,2" IsThreeState="False"
                                      Checked="StartupSetting_Changed"
                                      Unchecked="StartupSetting_Changed"/>
                            <CheckBox x:Name="CheckBoxCloseToTray"
                                      Content="閉じた時にタスクトレイに格納する"
                                      Margin="0,2" IsThreeState="False"
                                      Checked="CheckBoxCloseToTray_Checked"
                                      Unchecked="CheckBoxCloseToTray_Unchecked"/>
                            <CheckBox x:Name="CheckBoxCloseWhenDeactivated"
                                      Content="非アクティブになったら閉じる"
                                      Margin="0,2" IsThreeState="False"
                                      Checked="CheckBoxCloseWhenDeactivated_Changed"
                                      Unchecked="CheckBoxCloseWhenDeactivated_Changed"/>
                            <CheckBox x:Name="CheckBoxCloseAfterButtonClick"
                                      Content="コマンド送信ボタンを押したら閉じる"
                                      Margin="0,2"
                                      Checked="CheckBoxCloseAfterButtonClick_Changed"
                                      Unchecked="CheckBoxCloseAfterButtonClick_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="#18000000" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="グローバルホットキー" FontWeight="SemiBold"
                                       FontSize="14" Margin="0,0,0,6"/>
                            <CheckBox x:Name="CheckBoxHotkeyEnabled"
                                      Content="グローバルホットキーを有効にする"
                                      Margin="0,0,0,6"
                                      Checked="HotkeySetting_Changed"
                                      Unchecked="HotkeySetting_Changed"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="CheckBoxHotkeyCtrl" Content="Ctrl" Margin="0,0,18,0"
                                          Checked="HotkeySetting_Changed" Unchecked="HotkeySetting_Changed"/>
                                <CheckBox x:Name="CheckBoxHotkeyAlt" Content="Alt" Margin="0,0,18,0"
                                          Checked="HotkeySetting_Changed" Unchecked="HotkeySetting_Changed"/>
                                <CheckBox x:Name="CheckBoxHotkeyShift" Content="Shift" Margin="0,0,18,0"
                                          Checked="HotkeySetting_Changed" Unchecked="HotkeySetting_Changed"/>
                                <CheckBox x:Name="CheckBoxHotkeyWin" Content="Win" Margin="0,0,20,0"
                                          Checked="HotkeySetting_Changed" Unchecked="HotkeySetting_Changed"/>
                                <ComboBox x:Name="ComboBoxHotkeyKey" Width="140" Height="22"
                                          SelectionChanged="HotkeySetting_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="#18000000" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="マウス操作" FontWeight="SemiBold"
                                       FontSize="14" Margin="0,0,0,6"/>
                            <CheckBox x:Name="CheckBoxMouseGestureEnabled"
                                      Content="画面隅などでのマウス操作で表示"
                                      Margin="0,0,0,6"
                                      Checked="MouseGestureSetting_Changed"
                                      Unchecked="MouseGestureSetting_Changed"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="ComboBoxMouseCorner" Width="150" Height="22"
                                          Margin="0,0,10,0" SelectedValuePath="Tag"
                                          SelectionChanged="MouseGestureSetting_Changed">
                                    <ComboBoxItem Content="画面のどこでも" Tag="Anywhere"/>
                                    <ComboBoxItem Content="左上" Tag="TopLeft"/>
                                    <ComboBoxItem Content="右上" Tag="TopRight"/>
                                    <ComboBoxItem Content="左下" Tag="BottomLeft"/>
                                    <ComboBoxItem Content="右下" Tag="BottomRight"/>
                                </ComboBox>
                                <ComboBox x:Name="ComboBoxMouseGesture" Width="220" Height="22"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="MouseGestureSetting_Changed">
                                    <ComboBoxItem Content="カーソルを移動" Tag="MoveToCorner"/>
                                    <ComboBoxItem Content="クリック" Tag="LeftClick"/>
                                    <ComboBoxItem Content="右を押しながら左クリック" Tag="RightLeftClick"/>
                                    <ComboBoxItem Content="右ダブルクリック" Tag="RightDoubleClick"/>
                                    <ComboBoxItem Content="右トリプルクリック" Tag="RightTripleClick"/>
                                    <ComboBoxItem Content="右クリック長押し" Tag="RightLongPress"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="#18000000" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Language" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ComboBoxLanguage" Grid.Column="1" Height="22"
                                      SelectedValuePath="Tag"
                                      SelectionChanged="ComboBoxLanguage_SelectionChanged">
                                <ComboBoxItem Content="日本語" Tag="ja-JP"/>
                                <ComboBoxItem Content="English" Tag="en-US"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="#18000000" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="データのクリア" FontWeight="SemiBold"
                                       FontSize="14" Margin="0,0,0,6"/>
                            <Button Content="すべてのデータをクリア" Height="25"
                                    Margin="0,0,0,5" Click="ClearAllDataButton_Click"/>
                            <Button Content="すべてのボタンをクリア" Height="25"
                                    Margin="0,0,0,5" Click="ClearAllButtonsButton_Click"/>
                            <Button Content="センサーログをクリア" Height="25"
                                    Click="ClearSensorLogsButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="#18000000" BorderThickness="1"
                            CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="設定のバックアップ" FontWeight="SemiBold"
                                       FontSize="14" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="すべての設定をエクスポート"
                                           Grid.ColumnSpan="4" VerticalAlignment="Center"/>
                                <Button Grid.Column="5" Content="出力" Height="25"
                                        Click="ExportBackupButton_Click"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="すべての設定をインポート"
                                           Grid.ColumnSpan="4" VerticalAlignment="Center"/>
                                <Button Grid.Column="5" Content="入力" Height="25"
                                        Click="ImportBackupButton_Click"/>
                            </Grid>
                            <TextBlock Text="※バックアップにはトークンやSecretなどの認証情報も含まれます。第三者に渡らないよう、取り扱いに注意してください。"
                                       Foreground="#C0392B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Nature Remo設定">
            <Grid Margin="24" Width="480" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Nature Remo" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Margin="0,8,0,14" TextWrapping="Wrap"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="Nature Remo本体のIPアドレス、またはインスタンス名を設定します。"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="82"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TextBoxURL1" Height="24"/>
                    <Button Grid.Column="2" Content="保存" Height="25" Click="SaveButton_Click"/>
                    <Button x:Name="ButtonUrlAuto" Grid.Column="4" Content="自動取得" Height="25" Click="Button_Click_1"/>
                </Grid>
                <TextBlock Grid.Row="3" Margin="0,22,0,5" Text="クラウドアクセストークン"
                     FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBoxNatureRemoCloudToken" Grid.Row="4"
                       Height="24" Padding="7,4"
                       BorderBrush="{StaticResource ControlBorderBrush}"/>
                <StackPanel Grid.Row="5" Margin="0,8,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="サーバーコマンドでNature Remoクラウドに登録した家電・赤外線信号を使用する場合のみ必要です。ローカルAPIのみを使用する場合は設定不要です。使用する場合は、home.nature.globalでアクセストークンを発行して貼り付けてください。"/>
                    <TextBlock Margin="0,5,0,0" Text="※ トークンは第三者へ公開しないでください。"
                       FontSize="11" Foreground="#C42B1C"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="SwitchBot設定">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Width="480" HorizontalAlignment="Left">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="SwitchBot API v1.1" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Margin="0,8,0,16" TextWrapping="Wrap"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="SwitchBotアプリの開発者オプションで取得したTokenとSecretを入力してください。"/>

                <Border Grid.Row="2" Margin="0,0,0,16" Padding="12,10"
                  Background="{StaticResource CardBackgroundBrush}"
                  BorderBrush="#18000000" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Token・Secretの取得方法"
                                   FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="1. SwitchBotアプリへログインします。"
                                   FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="2. プロフィール → 環境設定（Preferences）→ 情報（About）を開きます。"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="3. 「アプリバージョン」を10回連続でタップします。"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="4. 表示された「開発者向けオプション」を開き、「トークンを取得」を選びます。"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="5. 表示されたTokenとSecretを下の欄へ貼り付けます。"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="※ TokenとSecretは第三者へ公開しないでください。"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#C42B1C"
                                   Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3" Text="Token" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBoxSwitchBotToken" Grid.Row="4" Height="24"
                       Padding="7,4" BorderBrush="{StaticResource ControlBorderBrush}"/>
                <TextBlock Grid.Row="5" Text="Secret" FontWeight="SemiBold" Margin="0,14,0,5"/>
                <StackPanel Grid.Row="6">
                    <PasswordBox x:Name="PasswordBoxSwitchBotSecret" Height="24"
                         Padding="7,4" BorderBrush="{StaticResource ControlBorderBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="接続テスト" Height="25" Margin="0,0,8,0"
                      Click="TestSwitchBotConnection_Click"/>
                        <Button Content="保存" Height="25"
                      Click="SaveSwitchBotSettings_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Tuya設定">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Width="480" HorizontalAlignment="Left">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Tuya Cloud API" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Margin="0,8,0,16" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Tuya Developer PlatformのCloud Projectで発行されたAccess IDとAccess Secretを入力してください。"/>
                    <Border Grid.Row="2" Margin="0,0,0,16" Padding="12,10" CornerRadius="8"
                            Background="{StaticResource CardBackgroundBrush}" BorderBrush="#18000000" BorderThickness="1">
                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                   Text="Tuya Developer PlatformでCloud Projectを作成し、IoT Coreを有効化して、Tuya SmartまたはSmart Lifeアプリのアカウントをリンクします。プロジェクトのOverviewに表示されるAccess ID/Client IDとAccess Secret/Client Secretを使用してください。データセンターはプロジェクト作成時に選んだ地域と一致させてください。"/>
                    </Border>
                    <TextBlock Grid.Row="3" Text="Access ID / Client ID" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TextBoxTuyaAccessId" Grid.Row="4" Height="24"/>
                    <TextBlock Grid.Row="5" Text="Access Secret / Client Secret" FontWeight="SemiBold" Margin="0,14,0,5"/>
                    <PasswordBox x:Name="PasswordBoxTuyaAccessSecret" Grid.Row="6" Height="24" Padding="7,4"
                                 BorderBrush="{StaticResource ControlBorderBrush}"/>
                    <StackPanel Grid.Row="7">
                        <TextBlock Text="データセンター" FontWeight="SemiBold" Margin="0,14,0,5"/>
                        <ComboBox x:Name="ComboBoxTuyaEndpoint" Height="22" SelectedValuePath="Tag">
                            <ComboBoxItem Content="アメリカ西部" Tag="https://openapi.tuyaus.com"/>
                            <ComboBoxItem Content="アメリカ東部" Tag="https://openapi-ueaz.tuyaus.com"/>
                            <ComboBoxItem Content="ヨーロッパ中部" Tag="https://openapi.tuyaeu.com"/>
                            <ComboBoxItem Content="ヨーロッパ西部" Tag="https://openapi-weaz.tuyaeu.com"/>
                            <ComboBoxItem Content="インド" Tag="https://openapi.tuyain.com"/>
                            <ComboBoxItem Content="シンガポール" Tag="https://openapi-sg.iotbing.com"/>
                            <ComboBoxItem Content="中国" Tag="https://openapi.tuyacn.com"/>
                        </ComboBox>
                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#C42B1C"
                                   Text="※ Access Secretは第三者へ公開しないでください。"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="接続テスト" Height="25" Margin="0,0,8,0" Click="TestTuyaConnection_Click"/>
                            <Button Content="保存" Height="25" Click="SaveTuyaSettings_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
